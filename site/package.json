{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed:admin": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file=.env.local scripts/seed-admin.ts",
    "schema:diff": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/schema-diff.ts",
    "migrate": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/migrate.ts",
    "fal:gen": "tsx --env-file=.env.local scripts/fal-generate.ts",
    "tov:check": "tsx scripts/tov-checker.ts",
    "lint:schema": "tsx scripts/lint-schema.ts",
    "check:links": "tsx scripts/check-links.ts",
    "lint:slug": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file=.env.local scripts/lint-slug.ts",
    "lint:slug:prod": "tsx --require=./scripts/_payload-cjs-shim.cjs scripts/lint-slug.ts",
    "prebuild": "pnpm lint:slug:prod",
    "audit:prune": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file=.env.local scripts/audit/prune.ts",
    "audit:prune:prod": "tsx --require=./scripts/_payload-cjs-shim.cjs scripts/audit/prune.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test blocks/__tests__/master-template.test.ts lib/master-template/__tests__/getBlocksForLayer.test.ts components/blocks/__tests__/array-render-shape.test.tsx lib/leads/__tests__/callbackDeadline.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/translations": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "bcryptjs": "^3.0.3",
    "graphql": "^16.13.2",
    "next": "16.4.2",
    "nodemailer": "^8.0.7",
    "otplib": "^12.0.1",
    "payload": "^3.91.0",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
