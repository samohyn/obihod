{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed:admin": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file=.env.local scripts/seed-admin.ts",
    "seed:home": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/seed-home-c4.ts",
    "seed:subservice": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/seed-subservice.ts",
    "seed:page": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/seed-page.ts",
    "sync:latest-versions": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/sync-latest-versions.ts",
    "fix:offer-logic": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/fix-offer-logic.ts",
    "stage2:offer": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/stage2-offer.ts",
    "seed:geo-sub": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/seed-geo-sub.ts",
    "fix:sub-district-texts": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/fix-sub-district-texts.ts",
    "offer:tokens": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/offer-tokens.ts",
    "fix:markdown-bodies": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/fix-markdown-bodies.ts",
    "seed:chrome": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/seed-chrome.ts",
    "revalidate:site": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/revalidate-site.ts",
    "schema:diff": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/schema-diff.ts",
    "migrate": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file-if-exists=.env.local scripts/migrate.ts",
    "fal:gen": "tsx --env-file=.env.local scripts/fal-generate.ts",
    "tov:check": "tsx scripts/tov-checker.ts",
    "lint:schema": "tsx scripts/lint-schema.ts",
    "check:links": "tsx scripts/check-links.ts",
    "snapshot:pages": "tsx scripts/snapshot-pages.ts snap",
    "snapshot:diff": "tsx scripts/snapshot-pages.ts diff",
    "lint:slug": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file=.env.local scripts/lint-slug.ts",
    "lint:slug:prod": "tsx --require=./scripts/_payload-cjs-shim.cjs scripts/lint-slug.ts",
    "prebuild": "pnpm lint:slug:prod",
    "audit:prune": "tsx --require=./scripts/_payload-cjs-shim.cjs --env-file=.env.local scripts/audit/prune.ts",
    "audit:prune:prod": "tsx --require=./scripts/_payload-cjs-shim.cjs scripts/audit/prune.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.json",
    "type-check:ts6": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test lib/leads/__tests__/callbackDeadline.test.ts lib/leads/__tests__/sla.test.ts components/blocks/v3/__tests__/iconNames.test.ts lib/blocks/v3/__tests__/fromPayload.test.ts lib/__tests__/breadcrumbs.test.ts lib/admin/__tests__/revalidateSite.test.ts lib/__tests__/offer.test.ts lib/leads/__tests__/form.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/translations": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "bcryptjs": "^3.0.3",
    "graphql": "^16.14.2",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "payload": "^3.91.0",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
