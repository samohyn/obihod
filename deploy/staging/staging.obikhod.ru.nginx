# staging.obikhod.ru — копия сайта для показа владельцу (план 09, этап 1).
# Пароль (basic auth): /etc/nginx/staging.htpasswd. Закрыто от индексации всегда.
# HTTPS добавляет certbot --nginx (блок 443 появится ниже автоматически).
server {
    server_name staging.obikhod.ru;
    listen 80;
    listen [::]:80;
    client_max_body_size 25m;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
        try_files $uri =404;
    }

    location = /robots.txt {
        auth_basic off;
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        auth_basic "Обиход staging";
        auth_basic_user_file /etc/nginx/staging.htpasswd;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # пароль staging приложению не нужен
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_redirect ~^https?://localhost:3001/(.*)$ https://staging.obikhod.ru/$1;
    }
}
