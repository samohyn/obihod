# /etc/obikhod/backup.env — права 600, владелец root. Не коммитить заполненный файл.

# Копия бэкапов в S3 в РФ (restic). Пусто — бэкапы только на этом сервере.
# Пример для Selectel: s3:https://s3.ru-1.storage.selcloud.ru/<bucket>/obikhod
#RESTIC_REPOSITORY=
#RESTIC_PASSWORD=          # пароль шифрования репозитория — хранить ещё и вне сервера
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=ru-1

# Уведомления о сбоях на почту (Telegram с сервера недоступен).
#NOTIFY_SMTP_URL=smtps://smtp.beget.com:465
#NOTIFY_SMTP_USER=noreply@obikhod.ru
#NOTIFY_SMTP_PASS=
#NOTIFY_TO=partner@obikhod.ru
